# Required — Turso (libsql) database. Create with: turso db create cognara
TURSO_DATABASE_URL=libsql://cognara-<username>.<region>.turso.io
TURSO_AUTH_TOKEN=<turso db tokens create cognara>

# Required in production — gates educator publish + full DB reset.
# Generate with: openssl rand -hex 32. Leave empty in local dev only.
ADMIN_TOKEN=

# Optional — live Meta AI teaching + grading. Omit to stay in offline local mode.
LLAMA_API_URL=
LLAMA_API_KEY=
LLAMA_MODEL=Llama-4-Maverick-17B-128E-Instruct
LLM_TIMEOUT_MS=10000

# Optional — API abuse protection (requests per window per IP).
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
